# Required for email notifications: private Resend API key with sending access.
# Never commit a real key. Dashboard submission can still succeed without email.
RESEND_API_KEY=

# Required for email notifications: sender on your own Resend-verified domain.
RESEND_FROM_EMAIL="Vishal Portfolio <contact@your-verified-domain.com>"

# Optional: recipient; the contact route defaults to this Gmail address.
CONTACT_TO_EMAIL=sahanivishal0808@gmail.com

# Optional: private dashboard API override. Blank uses the existing
# NEXT_PUBLIC_CONTACT_API_URL, then https://admin.vishal.it.com/api/contact-us.
# For production, explicitly use your production dashboard endpoint, not a local URL.
CONTACT_API_URL=

# Optional: blank preserves the compact/full contact form variant defaults.
NEXT_PUBLIC_CONTACT_SOURCE=
